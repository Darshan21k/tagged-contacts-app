{
  "expo": {
    "name": "ContactNow",
    "slug": "tagged-contacts-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.darshank21.taggedcontactsapp",
      "splashScreen": {
        "backgroundColor": "#FFFFFF",
        "image": "./assets/icon.png",
        "resizeMode": "contain"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "813d9b4f-37a5-480e-8dd1-40034257a8f8"
      }
    },
    "plugins": [
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}
